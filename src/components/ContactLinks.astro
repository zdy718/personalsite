---
// Contact as a postcard: the message (slot) on the left, the address side on
// the right, and the stamp is the email button.
import { profile, education } from '../data/site';
---

<div class="postcard">
  <div class="pc-msg">
    <slot />
    <ul class="links">
      <li><a class="btn btn-secondary" href={profile.github} target="_blank" rel="me noopener">GitHub<span class="visually-hidden"> (opens in a new tab)</span></a></li>
      <li><a class="btn btn-secondary" href={profile.linkedin} target="_blank" rel="me noopener">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
      <li><a class="btn btn-secondary" href={profile.resume} target="_blank" rel="noopener">Resume (PDF)<span class="visually-hidden">, opens in a new tab</span></a></li>
      <li><a class="dl" href={profile.resume} download="Zi-Dane-Yan-Resume.pdf">Download resume</a></li>
    </ul>
  </div>

  <div class="pc-addr">
    <div class="pc-top">
      <span class="postmark" aria-hidden="true">
        <span>Lincoln NE</span>
        <span class="pm-year">2026</span>
      </span>
      <a class="stamp" href={`mailto:${profile.email}`}>
        <span class="stamp-art">
          <svg viewBox="0 0 40 28" aria-hidden="true"><rect x="2" y="2" width="36" height="24" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M3 4l17 12L37 4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg>
          <span class="stamp-label">Email me</span>
          <span class="stamp-value" aria-hidden="true">26¢</span>
        </span>
      </a>
    </div>

    <div class="pc-lines">
      <p class="line"><span class="lbl">To</span> {profile.name}</p>
      <p class="line email-row">
        <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <button type="button" class="copy" data-copy={profile.email} hidden>
          <span data-copy-label>Copy</span>
        </button>
      </p>
      <p class="line">{education.location}</p>
      <span class="status" role="status" aria-live="polite" data-copy-status></span>
    </div>
  </div>
</div>

<style>
  .postcard {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background: var(--surface);
    border: 2px solid var(--line);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow);
  }
  .pc-msg { padding: clamp(24px, 4vw, 48px); }
  .pc-addr {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s6);
    padding: clamp(24px, 4vw, 40px);
    border-left: 2px solid var(--line);
  }

  .links { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3); margin: 0; padding: 0; }
  .dl { display: inline-flex; align-items: center; min-height: 44px; padding-inline: var(--s2); font-weight: 600; font-size: 0.9375rem; }

  .pc-top { display: flex; justify-content: flex-end; align-items: flex-start; gap: var(--s4); }

  /* Circular postmark with cancellation waves */
  .postmark {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    width: 92px;
    height: 92px;
    margin-top: 18px;
    border: 2px dashed var(--muted);
    border-radius: 50%;
    color: var(--muted);
    font: 700 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transform: rotate(-12deg);
  }
  .pm-year { font-size: 0.9375rem; }

  /* The stamp: perforated paper edge around a coloured panel */
  .stamp {
    position: relative;
    z-index: 1;
    display: block;
    padding: 7px;
    background:
      radial-gradient(circle, transparent 3.5px, var(--surface) 4px) -6px -6px / 12px 12px;
    filter: drop-shadow(2px 3px 0 var(--line));
    transform: rotate(4deg);
    text-decoration: none;
    transition: transform 160ms var(--ease);
  }
  .stamp:hover { transform: rotate(0deg) translateY(-2px); }
  .stamp:active { transform: rotate(0deg) translate(1px, 1px); }
  .stamp-art {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 112px;
    padding: 14px 10px 10px;
    border: 2px solid var(--line);
    background: var(--mustard);
    color: var(--on-bright, var(--ink));
  }
  .stamp-art svg { width: 44px; height: 32px; }
  .stamp-label { font: 700 0.875rem/1.1 var(--font-body); }
  .stamp-value { align-self: end; justify-self: end; font: 700 0.75rem/1 var(--font-mono); }

  /* Ruled address lines */
  .pc-lines { display: grid; gap: var(--s2); }
  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s3);
    margin: 0;
    padding: var(--s2) 0;
    border-bottom: 2px solid var(--border);
    font-size: 1.0625rem;
  }
  .lbl { font: 700 0.75rem/1 var(--font-mono); color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; }
  .email {
    font: 700 clamp(1.0625rem, 0.95rem + 0.6vw, 1.375rem)/1.3 var(--font-head);
    color: var(--ink);
    word-break: break-all;
    user-select: all;
  }
  .email:hover { color: var(--primary); }
  .copy {
    min-height: 32px;
    padding: 4px 12px;
    border: 2px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
    font: 700 0.8125rem/1 var(--font-mono);
    cursor: pointer;
  }
  .copy:hover { background: var(--soft); }
  .status { font-size: 0.875rem; color: var(--primary); font-weight: 600; min-height: 1.4em; }

  @media (max-width: 860px) {
    .postcard { grid-template-columns: 1fr; }
    .pc-addr { border-left: 0; border-top: 2px dashed var(--line); }
  }
  @media (prefers-reduced-motion: reduce) {
    .stamp, .stamp:hover, .stamp:active { transition: none; transform: rotate(4deg); }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  const label = btn?.querySelector<HTMLElement>('[data-copy-label]');
  if (btn && status && label && navigator.clipboard) {
    btn.hidden = false;
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = 'Copied';
        status.textContent = 'Email address copied to clipboard.';
      } catch {
        status.textContent = 'Couldn’t copy automatically. The address is selectable, so copy it manually.';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = 'Copy';
        status.textContent = '';
      }, 4000);
    });
  }
</script>
