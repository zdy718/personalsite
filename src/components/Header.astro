---
import { profile } from '../data/site';

const links = [
  { href: '/#about', label: 'About' },
  { href: '/#work', label: 'Work' },
  { href: '/#education', label: 'Education' },
  { href: '/#experience', label: 'Experience' },
];
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="wordmark" href="/"><span class="badge" aria-hidden="true">ZY</span>{profile.name}</a>

    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-btn
    >
      <span class="visually-hidden">Menu</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
        <path class="l1" d="M4 7h16" />
        <path class="l2" d="M4 12h16" />
        <path class="l3" d="M4 17h16" />
      </svg>
    </button>

    <nav id="site-nav" class="nav" aria-label="Primary" data-nav>
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
        <li>
          <a class="resume-link" href={profile.resume} target="_blank" rel="noopener">
            Resume<span class="visually-hidden"> (PDF, opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--canvas);
    border-bottom: 2px solid transparent;
    transition: border-color 180ms var(--ease), background-color 180ms var(--ease);
  }
  .site-header.is-scrolled { border-bottom-color: var(--line); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    gap: var(--s4);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
    padding-block: 8px;
  }
  .wordmark:hover { color: var(--ink); }
  .badge {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    border: 2px solid var(--line);
    background: var(--mustard);
    box-shadow: 2px 2px 0 var(--line);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    transition: transform 150ms var(--ease);
  }
  .wordmark:hover .badge { transform: rotate(-6deg); }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--s1);
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s3);
    border-radius: var(--radius-control);
    color: var(--ink);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .nav a:hover { color: var(--ink); background: var(--soft); }
  .nav .resume-link {
    color: #fff;
    background: var(--primary);
    border: 2px solid var(--line);
    box-shadow: 2px 2px 0 var(--line);
    margin-left: var(--s2);
  }
  .nav .resume-link:hover { background: var(--primary-hover); color: #fff; }

  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--line);
    border-radius: var(--radius-control);
    box-shadow: 2px 2px 0 var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .menu-btn path {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transition: transform 180ms var(--ease), opacity 120ms var(--ease);
    transform-origin: 12px 12px;
  }
  .menu-btn[aria-expanded='true'] .l1 { transform: translateY(5px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .l2 { opacity: 0; }
  .menu-btn[aria-expanded='true'] .l3 { transform: translateY(-5px) rotate(-45deg); }

  @media (max-width: 759px) {
    :global(.js) .menu-btn { display: inline-flex; }
    :global(.js) .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--canvas);
      border-bottom: 2px solid var(--line);
    }
    :global(.js) .nav.is-open { display: block; }
    :global(.js) .nav ul { flex-direction: column; padding: var(--s2) var(--gutter) var(--s4); }
    :global(.js) .nav a { width: 100%; padding-inline: var(--s3); }
    :global(.js) .nav .resume-link { margin: var(--s2) 0 0; justify-content: center; }
    /* Without JS, links wrap under the wordmark instead. */
    .bar { flex-wrap: wrap; }
    .nav ul { flex-wrap: wrap; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean, returnFocus = false) => {
    btn.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    if (!open && returnFocus) btn.focus();
  };

  btn.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    setOpen(open);
    if (open) nav.querySelector('a')?.focus();
  });
  nav.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') setOpen(false, true);
  });
  document.addEventListener('click', (e) => {
    if (btn.getAttribute('aria-expanded') === 'true' && !header.contains(e.target as Node)) setOpen(false);
  });
  window.matchMedia('(min-width: 760px)').addEventListener('change', (m) => {
    if (m.matches) setOpen(false);
  });
</script>
