---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceList from '../components/ExperienceList.astro';
import ContactLinks from '../components/ContactLinks.astro';
import ProjectPreview, { type PreviewProject } from '../components/interactive/ProjectPreview';
import Constellation from '../components/interactive/Constellation';
import QuestSticker from '../components/QuestSticker.astro';
import Clapper from '../components/Clapper.astro';
import { capabilities, education, focus, profile, projects } from '../data/site';
import universeImg from '../assets/work/universe-map.png';
import stuntImg from '../assets/work/stunt-double.png';

const images = { 'universe-map': universeImg, 'stunt-double': stuntImg } as const;
const [um, sd] = projects;

async function poster(img: ImageMetadata, alt: string) {
  const widths = [480, 800, 1200];
  const out = await Promise.all(widths.map((w) => getImage({ src: img, width: w, format: 'webp' })));
  return {
    src: out[1].src,
    srcset: out.map((o, i) => `${o.src} ${widths[i]}w`).join(', '),
    width: Number(out[1].attributes.width),
    height: Number(out[1].attributes.height),
    alt,
  };
}

const previews: PreviewProject[] = [
  {
    id: 'universe',
    slug: um.id,
    bar: 'teal',
    title: um.title,
    blurb: 'A 3D catalog of 169,000+ stars, planets, and galaxies.',
    poster: await poster(universeImg, um.imageAlt),
    demoUrl: um.demoUrl,
    exploreLabel: 'Explore preview',
  },
  {
    id: 'stunt',
    slug: sd.id,
    bar: 'rose',
    title: sd.title,
    blurb: 'A browser game with five movie-inspired levels.',
    poster: await poster(stuntImg, sd.imageAlt),
    demoUrl: sd.demoUrl,
    exploreLabel: 'Try a quick jump',
  },
];

// Desktop shortcuts in the hero; each one is a real link.
const shortcuts = [
  { href: '#about', label: 'about.txt', icon: 'txt' },
  { href: '#work', label: 'projects', icon: 'folder' },
  { href: '#education', label: 'education', icon: 'cap' },
  { href: '#experience', label: 'experience', icon: 'case' },
  { href: profile.resume, label: 'resume.pdf', icon: 'pdf', external: true },
  { href: '#contact', label: 'contact.eml', icon: 'mail' },
] as const;

const marquee = `Now showing · ${um.title} · ${sd.title} · Full-stack web apps · Class of '26 · `.toUpperCase();
---

<BaseLayout
  title="Zi-Dane Yan | Software Engineer"
  description="Zi-Dane Yan is a full-stack software engineer and computer science student at the University of Nebraska–Lincoln, graduating in December 2026, who builds web apps end to end, from Python and PostgreSQL backends to interactive React and Three.js interfaces."
>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-head">
      <div>
        <p class="eyebrow">{profile.name} · Full-stack {profile.role}</p>
        <h1 id="hero-title">I build useful software and <span class="hl">other things.</span></h1>
      </div>
      <div class="hero-side">
        <div class="hero-actions">
          <a class="btn btn-primary" href="#work">See my projects</a>
          <a class="btn btn-secondary" href={profile.resume} target="_blank" rel="noopener">
            View resume<span class="visually-hidden"> (PDF, opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>

    <div class="monitor">
      <div class="bezel">
        <div class="desk">
      <nav class="desk-icons" aria-label="Shortcuts">
        <ul>
          {shortcuts.map((s) => (
            <li>
              <a
                href={s.href}
                {...('external' in s ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <svg class={`ico ico-${s.icon}`} viewBox="0 0 40 40" aria-hidden="true">
                  {s.icon === 'txt' && (
                    <>
                      <path class="i-paper" d="M9 4h16l7 7v25H9z" />
                      <path class="i-fold" d="M25 4v7h7" />
                      <path class="i-rule" d="M14 18h13M14 23h13M14 28h9" />
                    </>
                  )}
                  {s.icon === 'folder' && (
                    <>
                      <path class="i-tab" d="M4 10h12l3 4h17v20H4z" />
                      <path class="i-front" d="M4 16h32v18H4z" />
                    </>
                  )}
                  {s.icon === 'cap' && (
                    <>
                      <path class="i-front" d="M2 15l18-8 18 8-18 8z" />
                      <path class="i-paper" d="M10 19v8c0 2 4.5 4 10 4s10-2 10-4v-8l-10 4z" />
                      <path class="i-rule" d="M34 17v10" />
                    </>
                  )}
                  {s.icon === 'case' && (
                    <>
                      <path class="i-fold" d="M14 12V8h12v4" />
                      <rect class="i-tab" x="4" y="12" width="32" height="22" rx="3" />
                      <path class="i-rule" d="M4 21h32" />
                    </>
                  )}
                  {s.icon === 'pdf' && (
                    <>
                      <path class="i-paper" d="M9 4h16l7 7v25H9z" />
                      <path class="i-fold" d="M25 4v7h7" />
                      <rect class="i-badge" x="6" y="20" width="22" height="10" rx="2" />
                    </>
                  )}
                  {s.icon === 'mail' && (
                    <>
                      <rect class="i-paper" x="4" y="9" width="32" height="22" rx="2" />
                      <path class="i-fold" d="M5 10l15 11 15-11" />
                    </>
                  )}
                </svg>
                <span class="ico-label">{s.label}{'external' in s && <span class="visually-hidden"> (PDF, opens in a new tab)</span>}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="desk-window">
        <ProjectPreview client:load projects={previews} />
      </div>

        </div>
        <div class="chin">
        <span class="brand" aria-hidden="true">ZY·26</span>
        <span class="vents" aria-hidden="true"></span>
        <span class="power">
          <span class="power-led" aria-hidden="true"></span>
          <Clapper />
        </span>
        </div>
      </div>
      <div class="stand" aria-hidden="true"><span class="neck"></span><span class="base"></span></div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {Array.from({ length: 6 }, () => <span>{marquee}</span>)}
    </div>
  </div>

  <section id="about" class="section container" aria-labelledby="about-title">
    <div class="bento" data-reveal>
      <div class="tile t-about">
        <p class="eyebrow">01 · About</p>
        <h2 id="about-title">About</h2>
        <p>
          I’m happiest owning a feature from the database schema to the last pixel. The projects I’m proudest of are
          the ones where the hard part is invisible to the person using them: merging astronomy catalogs so one search
          box just works, or proving every level of a game can be beaten before anyone plays it.
        </p>
        <QuestSticker quest="wall" label="Set a route" icon="🧗" tilt={3} color="sky" class="route-sticker" />
      </div>

      <div class="tile t-focus">
        <h3>What I focus on</h3>
        <ol class="focus-list">
          {focus.map((f, i) => (
            <li>
              <span class="f-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="f-title">{f.title}</p>
                <p class="f-detail">{f.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="window tile t-tools">
        <div class="window-bar teal">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>toolbox</span>
        </div>
        <div class="skills-body">
          <h3 class="visually-hidden">What I work with</h3>
          {capabilities.map((c) => (
            <div class="skill-group">
              <h4>{c.group}</h4>
              <ul>
                {c.items.map((i) => <li class="chip">{i}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div class="t-sky">
        <Constellation client:idle />
      </div>

    </div>
  </section>

  <section id="work" class="section container" aria-labelledby="work-title">
    <div class="section-head" data-reveal>
      <p class="eyebrow">02 · Work</p>
      <div class="head-row">
        <h2 id="work-title">Projects</h2>
        <QuestSticker quest="drawer" label="Open desk drawer" icon="🗄️" tilt={-4} color="rose" />
      </div>
      <p>
        Two independent projects I designed and built end to end.
      </p>
    </div>

    <div class="work-grid">
      <ProjectCard project={um} image={images['universe-map']} barClass="teal" />
      <ProjectCard project={sd} image={images['stunt-double']} barClass="rose" />
    </div>
  </section>

  <section id="education" class="section container" aria-labelledby="edu-title">
    <div class="section-head" data-reveal>
      <p class="eyebrow">03 · Education</p>
      <h2 id="edu-title">Education</h2>
    </div>

    <div class="edu" data-reveal>
      <div class="window degree">
        <div class="window-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>diploma.txt</span>
        </div>
        <div class="degree-body">
          <p class="grad-badge">Graduating {education.graduation}</p>
          <h3>{education.degree}</h3>
          <p class="minor">{education.minor}</p>
          <dl>
            <div><dt>School</dt><dd>{education.school}</dd></div>
            <div><dt>Location</dt><dd>{education.location}</dd></div>
            <div><dt>Dates</dt><dd>{education.dates}</dd></div>
          </dl>
        </div>
      </div>

      <div class="edu-side">
        <h3 class="side-title">Outside the classroom</h3>
        <ul class="highlights">
          {education.highlights.map((h) => (
            <li>
              <p class="h-title">{h.title}</p>
              <p class="h-detail">{h.detail}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="experience" class="section container" aria-labelledby="xp-title">
    <div class="section-head" data-reveal>
      <p class="eyebrow">04 · Experience</p>
      <h2 id="xp-title">Experience</h2>
      <p>Teaching a systems course, and building production software for two real clients.</p>
    </div>
    <ExperienceList />
  </section>

  <section id="contact" class="section container" aria-labelledby="contact-title">
    <div data-reveal>
      <ContactLinks>
        <p class="eyebrow">05 · Contact</p>
        <h2 id="contact-title">Have something in mind?</h2>
        <p class="contact-lede">The best way to reach me is email. I’m happy to talk about roles, projects, or anything you saw here.</p>
      </ContactLinks>
    </div>
  </section>
</BaseLayout>


<style>
  /* ---------- Hero: title card above a centred monitor ---------- */
  .hero { padding-block: clamp(16px, 1.5vw, 24px) clamp(48px, 5vw, 72px); }
  .hero-head {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: var(--s4) var(--s7);
    align-items: end;
    max-width: 1040px;
    margin: 0 auto clamp(20px, 2vw, 28px);
  }
  .hero-head h1 { font-size: clamp(2rem, 1.4rem + 1.9vw, 2.875rem); }
  .hl {
    background: linear-gradient(transparent 62%, var(--mustard) 62%, var(--mustard) 92%, transparent 92%);
    padding-inline: 2px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--s3); padding-bottom: 6px; }

  /* The monitor */
  .monitor { max-width: 860px; margin-inline: auto; }
  .bezel {
    position: relative;
    z-index: 1;
    padding: clamp(10px, 1.4vw, 18px) clamp(10px, 1.4vw, 18px) 0;
    border: 2px solid var(--line);
    border-radius: 30px 30px 20px 20px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 92%, #fff), color-mix(in srgb, var(--surface) 85%, var(--line)));
    box-shadow: var(--shadow), inset 0 2px 0 rgb(255 255 255 / 0.35);
  }
  .chin {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s4);
    padding: 8px 6px 9px;
  }
  .brand { font: 700 0.8125rem/1 var(--font-mono); letter-spacing: 0.2em; color: var(--muted); }
  .vents {
    width: 90px;
    height: 12px;
    background: repeating-linear-gradient(90deg, color-mix(in srgb, var(--line) 45%, transparent) 0 3px, transparent 3px 8px);
    border-radius: 3px;
  }
  .power { display: flex; align-items: center; justify-content: flex-end; gap: var(--s3); }
  .power-led {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: #3fa66b;
    box-shadow: 0 0 8px #3fa66b;
  }
  .stand { display: grid; justify-items: center; }
  .neck {
    width: 110px;
    height: 18px;
    margin-top: -2px;
    border: 2px solid var(--line);
    border-top: 0;
    background: color-mix(in srgb, var(--surface) 80%, var(--line));
    clip-path: polygon(12% 0, 88% 0, 100% 100%, 0 100%);
  }
  .base {
    width: 300px;
    max-width: 70%;
    height: 16px;
    border: 2px solid var(--line);
    border-radius: 10px 10px 6px 6px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  /* The screen: desktop with shortcuts and the cascaded project windows */
  .desk {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--line);
    border-radius: 14px;
    background:
      radial-gradient(color-mix(in srgb, var(--line) 14%, transparent) 1px, transparent 1.4px) 0 0 / 14px 14px,
      radial-gradient(ellipse at 50% 60%, color-mix(in srgb, var(--sky) 70%, var(--canvas)), color-mix(in srgb, var(--sky) 35%, var(--canvas)));
    box-shadow: inset 0 0 0 4px color-mix(in srgb, var(--line) 25%, transparent), inset 0 0 40px rgb(0 0 0 / 0.18);
    overflow: hidden;
  }
  .desk-icons ul {
    list-style: none;
    margin: 0;
    padding: var(--s3) var(--s4) 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 2px;
  }
  .desk-icons a {
    display: grid;
    justify-items: center;
    gap: 3px;
    padding: 4px;
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
  }
  .desk-icons a:hover .ico-label,
  .desk-icons a:focus-visible .ico-label { background: var(--primary); color: #fff; }
  .ico { width: 32px; height: 32px; overflow: visible; transition: transform 140ms var(--ease); }
  .desk-icons a:hover .ico { transform: translateY(-2px); }
  .ico path, .ico rect { stroke: var(--line); stroke-width: 2; stroke-linejoin: round; }
  .i-paper { fill: var(--surface); }
  .i-fold { fill: var(--soft); }
  .i-rule { fill: none; stroke-width: 1.6 !important; }
  .i-tab { fill: color-mix(in srgb, var(--mustard) 70%, var(--line)); }
  .i-front { fill: var(--mustard); }
  .i-badge { fill: var(--accent); }
  .ico-mail .i-fold { fill: none; }
  .ico-label {
    padding: 1px 6px;
    border-radius: 4px;
    font: 700 0.6875rem/1.4 var(--font-mono);
    white-space: nowrap;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
  }
  .desk-window { padding: var(--s3) clamp(12px, 3vw, 32px) clamp(16px, 2.5vw, 28px); }

  /* Wide screens: icons line up down the left edge like a real desktop */
  @media (min-width: 900px) {
    .desk { display: grid; grid-template-columns: auto 1fr; align-items: start; }
    .desk-icons ul { grid-template-columns: 1fr; gap: 6px; padding: var(--s4) 0 var(--s4) var(--s3); }
    .desk-window { padding: var(--s3) var(--s5) var(--s4) var(--s3); }
  }

  /* ---------- About: bento grid ---------- */
  .bento {
    display: grid;
    grid-template-columns: 7fr 5fr;
    grid-template-areas:
      'about tools'
      'focus focus'
      'sky   sky';
    gap: var(--s5);
  }
  .tile {
    background: var(--surface);
    border: 2px solid var(--line);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-sm);
    padding: var(--s6);
  }
  .t-about { grid-area: about; }
  .t-about h2 { margin-bottom: var(--s4); }
  .t-about p:last-child { margin: 0; max-width: 62ch; }
  .t-focus { grid-area: focus; background: var(--soft); }
  .t-focus h3 { font-size: 1.375rem; margin-bottom: var(--s4); }
  .focus-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s5); }
  .focus-list li { display: grid; grid-template-columns: auto 1fr; gap: var(--s4); align-items: start; }
  .f-num {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 2px solid var(--line);
    border-radius: 50%;
    background: var(--mustard);
    color: var(--on-bright, var(--ink));
    font: 700 0.8125rem/1 var(--font-mono);
  }
  .focus-list li:nth-child(2) .f-num { background: var(--sky); }
  .focus-list li:nth-child(3) .f-num { background: var(--rose); }
  .f-title { margin: 0; font-weight: 600; }
  .f-detail { margin: 2px 0 0; color: var(--muted); font-size: 0.9375rem; }
  .t-tools { grid-area: tools; padding: 0; box-shadow: var(--shadow-sm); }
  .skills-body { padding: var(--s6); }
  .skill-group + .skill-group { margin-top: var(--s5); }
  .skill-group h4 { font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 700; color: var(--muted); margin-bottom: var(--s2); }
  .skill-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }
  .t-sky { grid-area: sky; }
  .t-sky :global(.cn) { margin: 0; max-width: none; height: 100%; }
  /* Set a route sticker, pinned to the About tile's bottom-right corner */
  .t-about { position: relative; }
  .tile.t-about { padding-bottom: calc(var(--s6) + 32px); }
  .t-about :global(.route-sticker) { position: absolute; right: 18px; bottom: 16px; }
  .head-row { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s3) var(--s5); }

  /* ---------- Work ---------- */
  .work-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s6); align-items: stretch; }

  /* ---------- Education ---------- */
  .edu { display: grid; grid-template-columns: 5fr 7fr; gap: var(--s7); align-items: start; }
  .degree-body { padding: var(--s6); }
  .grad-badge {
    display: inline-block;
    margin: 0 0 var(--s4);
    padding: 4px 12px;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: var(--mustard);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    transform: rotate(-2deg);
  }
  .degree h3 { font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem); }
  .minor { margin: var(--s2) 0 var(--s5); color: var(--muted); font-weight: 600; }
  .degree dl { margin: 0; display: grid; gap: var(--s3); }
  .degree dl div { display: grid; grid-template-columns: 90px 1fr; gap: var(--s3); padding-top: var(--s3); border-top: 2px dashed var(--border); }
  .degree dt { font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 700; color: var(--muted); padding-top: 2px; }
  .degree dd { margin: 0; }
  .side-title { font-size: 1.375rem; margin-bottom: var(--s4); }
  .highlights { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s4); }
  .highlights li {
    position: relative;
    padding: var(--s4) var(--s5) var(--s4) 52px;
    background: var(--surface);
    border: 2px solid var(--line);
    border-radius: 16px;
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 18px;
    top: 21px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--line);
    background: var(--accent);
  }
  .highlights li:nth-child(2)::before { background: var(--mustard); }
  .h-title { margin: 0; font-weight: 600; }
  .h-detail { margin: 4px 0 0; color: var(--muted); font-size: 0.9375rem; }
  .edu-note { margin: var(--s4) 0 0; color: var(--muted); font-size: 0.9375rem; }

  /* ---------- Contact ---------- */
  .contact-lede { color: var(--muted); margin: var(--s4) 0 var(--s6); max-width: 48ch; }
  #contact h2 { font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem); }

  @media (max-width: 860px) {
    .hero-head { grid-template-columns: 1fr; align-items: start; }
    .hero-actions { justify-content: flex-start; }
  }
  @media (max-width: 960px) {
    .edu { grid-template-columns: 1fr; gap: var(--s7); }
    .bento { grid-template-columns: 1fr; grid-template-areas: 'about' 'focus' 'tools' 'sky'; }
    .focus-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 899px) {
    .work-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    .tile, .degree-body, .skills-body { padding: var(--s5); }
    .t-tools { padding: 0; }
    .degree dl div { grid-template-columns: 1fr; gap: 2px; }
    .desk-icons ul { grid-template-columns: repeat(3, minmax(0, 1fr)); padding: var(--s3) var(--s2) 0; gap: var(--s2) 0; }
    .bezel { border-radius: 20px 20px 14px 14px; }
    .vents { display: none; }
    .chin { grid-template-columns: 1fr auto; }
    .desk-window { padding: var(--s3) var(--s2); }
    .bezel { padding: 8px 8px 0; }
  }
</style>
